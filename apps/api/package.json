    "db:studio": "bunx --bun prisma studio"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^6.0.0",
    "openai": "^7.5.0",
    "zod": "^4.4.3"
  }
}
