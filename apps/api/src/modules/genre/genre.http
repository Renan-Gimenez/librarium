@baseURL = http://localhost:3333/api

### List all genres
GET {{baseURL}}/genres

### Get genre by slug
GET {{baseURL}}/genres/terror

### Create a new genre
POST {{baseURL}}/genres
Content-Type: application/json

{
  "slug": "terror",
  "name": "Terror"
}

### Update genre name
PUT {{baseURL}}/genres/terror
Content-Type: application/json

{
  "name": "Terror e Horror"
}

### Delete genre by slug
DELETE {{baseURL}}/genres/terror

