@baseURL = http://localhost:3333/api

### List all books (with pagination)
GET {{baseURL}}/books?page=1&limit=10

### List books with global search (searches title, author, and description)
GET {{baseURL}}/books?search=Cthulhu

### List books filtered by genre slug
GET {{baseURL}}/books?genre=terror

### List books filtered by author
GET {{baseURL}}/books?author=Lovecraft

### List books filtered by minimum rating
GET {{baseURL}}/books?minRating=4.5

### List books sorted by rating descending
GET {{baseURL}}/books?sortBy=rating&order=desc

### List books with combined filters, search, and pagination
GET {{baseURL}}/books?search=conto&genre=terror&minRating=4.0&sortBy=rating&order=desc&page=1&limit=5

### Get book by ID
# Replace with a valid book UUID
@bookId = 328006b5-7073-4556-9b57-61f22495b2ce
GET {{baseURL}}/books/{{bookId}}

### Create a new book
POST {{baseURL}}/books
Content-Type: application/json

{
  "title": "O Chamado de Cthulhu",
  "author": "H. P. Lovecraft",
  "description": "Conto de horror cósmico clássico.",
  "genreSlugs": ["terror"],
  "rating": 4.8
}

### Update book by ID
PUT {{baseURL}}/books/{{bookId}}
Content-Type: application/json

{
  "title": "O Chamado de Cthulhu - Edição Especial",
  "rating": 5.0
}

### Delete book by ID
DELETE {{baseURL}}/books/{{bookId}}

### Reindex embeddings (mode: missing)
POST {{baseURL}}/books/reindex
Content-Type: application/json

{
  "mode": "missing"
}

